# local | gemini | auto (local first, fall back to Gemini)
LLM_PROVIDER=local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Redact PII (email/phone/links) before text is sent to Gemini
REDACT_BEFORE_REMOTE=true
# Phoenix (docker compose up phoenix) OTLP endpoint; empty disables export
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GREENHOUSE_BOARDS=anthropic,databricks,stripe
LEVER_BOARDS=spotify,palantir
EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
